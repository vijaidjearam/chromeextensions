{
  "manifest_version": 3,
  "name": "URL Cleaner",
  "version": "1.1",
  "description": "Removes affiliate redirects from Dealabs links (digidip, metaffiliation, ...)",
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "*://*.digidip.net/*",
    "*://*.metaffiliation.com/*",
    "*://*.dealabs.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
